# Ollama's Strands provider wants the server root, not /v1/chat/completions.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:30b-a3b

# This app writes complete learning traces here and serves them at /trace-ui.
TRACE_DIRECTORY=traces
TRACE_CAPTURE_CONTENT=true

# Optional: export Strands' standard OpenTelemetry spans to an OTLP/HTTP
# collector. Do not put http://localhost:8777 here: Ollama Trace Lab is a UI,
# not an OTLP collector. Typical HTTP OTLP endpoints end in /v1/traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Keep the demo bounded when a local model gets stuck in a tool loop.
MAX_AGENT_TURNS=8
